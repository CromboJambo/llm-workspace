        GgufValueType::String => {
            // REAL DATA: llama.cpp v3 format after value_type is u64 string length in BIG-ENDIAN!

            let mut len_bytes = [0u8; 8];
            for i in 0..8 {
                len_bytes[i] = reader.read_u8()?;
            }
            eprintln!("DEBUG String u64 bytes: {:?}", len_bytes);

            let len_be = u64::from_be_bytes(len_bytes);
            let len_le = u64::from_le_bytes(len_bytes);
            eprintln!("DEBUG String len as BE: {}, LE: {}", len_be, len_le);

            let len = len_be; // Use big-endian

            if len > 1024 * 1024u64 {
                return Err(GgufError::Io(format!(
                    "string length {} exceeds max 1MB",
                    len
                )));
            }

            let bytes = read_bytes(reader, len as usize)?;
            Ok(GgufKvValue::String(String::from_utf8(bytes).map_err(GgufError::Utf8)?))
        }