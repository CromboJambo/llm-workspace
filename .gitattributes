# Prevent large binary blobs from being committed to git
*.gguf filter=lfs diff=lfs merge=lfs -text
*.safetensors filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text

# But keep tiny test fixtures (under 1MB) as regular files
conformance/test-corpus/tiny-model.gguf -filter -diff -merge -text
